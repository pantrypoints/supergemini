  "scripts": {
    "dev": "concurrently \"bun run dev:css\" \"bun run dev:hugo\"",
    "dev:hugo": "hugo server --buildDrafts --renderToMemory",
    "build": "bun run build:css && hugo --gc --minify --cleanDestinationDir",
    "build:css": "bunx @tailwindcss/cli -i assets/css/main.css -o static/css/tailwind.css --minify",
    "dev:css": "bunx @tailwindcss/cli -i assets/css/main.css -o static/css/tailwind.css --watch"
  },  
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "tailwindcss": "^4.2.1",
    "concurrently": "^8.2.2"
  }
}
